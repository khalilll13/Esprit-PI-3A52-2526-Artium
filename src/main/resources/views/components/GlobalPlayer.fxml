<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.Slider?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.image.ImageView?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.VBox?>
<?import javafx.scene.layout.StackPane?>

<VBox xmlns="http://javafx.com/javafx/20.0.2"
      xmlns:fx="http://javafx.com/fxml/1"
      fx:controller="controllers.GlobalPlayerController"
      styleClass="global-player-root"
      stylesheets="@../styles/global-player.css"
      alignment="BOTTOM_CENTER">

    <!-- Lyrics Panel (Hidden by default) -->
    <VBox fx:id="lyricsPanel" managed="false" visible="false"
          styleClass="global-player-lyrics-panel"
          spacing="10" alignment="CENTER"
          maxHeight="300" minHeight="200" VBox.vgrow="ALWAYS">
        <padding>
            <Insets top="15" right="20" bottom="15" left="20" />
        </padding>
        <HBox alignment="CENTER_LEFT" spacing="15">
            <Label fx:id="lyricsStatusLabel" text="Prêt à générer des paroles." styleClass="global-player-lyrics-status" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
            <Button fx:id="generateLyricsButton" text="Générer avec IA" onAction="#handleGenerateLyrics" styleClass="global-player-button-secondary" />
            <Button fx:id="copyLyricsButton" text="Copier" onAction="#handleCopyLyrics" styleClass="global-player-button-secondary" />
        </HBox>
        <TextArea fx:id="lyricsTextArea" editable="false" wrapText="true" VBox.vgrow="ALWAYS" styleClass="global-player-lyrics-area" />
    </VBox>

    <HBox alignment="CENTER_LEFT" styleClass="global-player-bar"
          minHeight="90" prefHeight="90" maxHeight="90">
        <padding>
            <Insets bottom="12" left="16" right="16" top="12" />
        </padding>

        <!-- LEFT: Square cover + track info -->
        <HBox alignment="CENTER_LEFT" spacing="14" styleClass="global-player-track-block"
              minWidth="240" prefWidth="280" maxWidth="320" HBox.hgrow="NEVER">
            <StackPane styleClass="global-player-cover-frame"
                       minWidth="56" minHeight="56" prefWidth="56" prefHeight="56"
                       maxWidth="56" maxHeight="56">
                <ImageView fx:id="coverImageView" fitHeight="56" fitWidth="56"
                           styleClass="global-player-cover" preserveRatio="true" />
            </StackPane>
            <VBox spacing="4" alignment="CENTER_LEFT" styleClass="global-player-track-info">
                <Label fx:id="titleLabel" styleClass="global-player-title"
                       text="Aucune piste en lecture" maxWidth="200" />
                <Label fx:id="artistLabel" styleClass="global-player-artist"
                       text="Artiste inconnu" maxWidth="200" />
            </VBox>
        </HBox>

        <!-- CENTER: controls + progress -->
        <VBox alignment="CENTER" spacing="8" styleClass="global-player-center"
              HBox.hgrow="ALWAYS" maxWidth="Infinity">

            <HBox alignment="CENTER" spacing="16" styleClass="global-player-controls">
                <Button fx:id="modeToggleButton" mnemonicParsing="false" onAction="#handleToggleMode"
                        styleClass="global-player-button global-player-button-icon" text="🔀"
                        minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />
                <Button mnemonicParsing="false" onAction="#handlePrevious"
                        styleClass="global-player-button global-player-button-icon" text="⏮"
                        minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />
                <Button fx:id="playPauseButton" mnemonicParsing="false" onAction="#handlePlayPause"
                        styleClass="global-player-playpause"
                        minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />
                <Button mnemonicParsing="false" onAction="#handleNext"
                        styleClass="global-player-button global-player-button-icon" text="⏭"
                        minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />
            </HBox>

            <HBox alignment="CENTER" spacing="8" styleClass="global-player-progress-row"
                  maxWidth="Infinity" HBox.hgrow="ALWAYS">
                <Label fx:id="timeLabel" styleClass="global-player-time"
                       text="0:00" minWidth="40" prefWidth="40" alignment="CENTER_RIGHT" />
                <Slider fx:id="progressSlider" max="1.0" blockIncrement="0.001"
                        styleClass="global-player-progress-slider"
                        onMousePressed="#handleSeekStart"
                        onMouseReleased="#handleSeekEnd"
                        minWidth="100" HBox.hgrow="ALWAYS" maxWidth="Infinity" />
                <Label fx:id="durationLabel" styleClass="global-player-time"
                       text="0:00" minWidth="40" prefWidth="40" alignment="CENTER_LEFT" />
            </HBox>

        </VBox>

        <!-- RIGHT: lyrics, volume, meta -->
        <HBox alignment="CENTER_RIGHT" spacing="12" styleClass="global-player-right"
              minWidth="220" prefWidth="260" maxWidth="300" HBox.hgrow="NEVER">

            <Button fx:id="lyricsToggleButton" mnemonicParsing="false" onAction="#handleToggleLyrics"
                    styleClass="global-player-button global-player-button-icon" text="🎤"
                    minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />

            <HBox alignment="CENTER" spacing="8" styleClass="global-player-volume-box">
                <Button fx:id="muteButton" mnemonicParsing="false" onAction="#handleMute"
                        styleClass="global-player-button global-player-button-icon" text="🔊"
                        minWidth="32" minHeight="32" maxWidth="32" maxHeight="32" />
                <Slider fx:id="volumeSlider" max="1.0" value="0.5" blockIncrement="0.01"
                        styleClass="global-player-volume-slider"
                        minWidth="93" prefWidth="93" maxWidth="93" />
            </HBox>

            <VBox alignment="CENTER_RIGHT" spacing="4" styleClass="global-player-state"
                  minWidth="80">
                <Label fx:id="metaLabel" styleClass="global-player-meta" text="Genre: -" />
                <Label fx:id="statusLabel" styleClass="global-player-status" text="Prêt" />
            </VBox>
        </HBox>

    </HBox>
</VBox>
