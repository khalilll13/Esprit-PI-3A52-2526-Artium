<?xml version="1.0" encoding="UTF-8"?>

<?import javafx.geometry.Insets?>
<?import javafx.scene.control.Button?>
<?import javafx.scene.control.ComboBox?>
<?import javafx.scene.control.Label?>
<?import javafx.scene.control.ScrollPane?>
<?import javafx.scene.control.TextArea?>
<?import javafx.scene.control.TextField?>
<?import javafx.scene.layout.BorderPane?>
<?import javafx.scene.layout.HBox?>
<?import javafx.scene.layout.Region?>
<?import javafx.scene.layout.TilePane?>
<?import javafx.scene.layout.VBox?>

<BorderPane styleClass="music-front-root" xmlns="http://javafx.com/javafx/20.0.2" xmlns:fx="http://javafx.com/fxml/1" fx:controller="controllers.amateur.MusicfrontController">
    <top>
        <VBox spacing="20.0" styleClass="music-front-header">
            <padding>
                <Insets top="30.0" right="40.0" bottom="20.0" left="40.0" />
            </padding>
            <HBox alignment="CENTER_LEFT" spacing="16.0">
                <VBox spacing="6.0" HBox.hgrow="ALWAYS">
                    <Label text="Découvrir Musique" styleClass="music-front-title" />
                    <Label text="Explorez des artistes, playlists et morceaux conçus pour vous." styleClass="music-front-subtitle" />
                </VBox>
            </HBox>

            <HBox fx:id="musicSearchBar" spacing="12.0" alignment="CENTER_LEFT">
                <TextField fx:id="searchField" promptText="Rechercher un titre, genre, artiste..." styleClass="music-front-search-field" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleSearch" text="Rechercher" styleClass="music-front-search-button" />
                <Button mnemonicParsing="false" onAction="#handleClearSearch" text="Effacer" styleClass="music-front-clear-button" />
                <ComboBox fx:id="sortMusicComboBox" prefWidth="180.0" promptText="Trier par" styleClass="music-front-sort-combo" />
            </HBox>

            <HBox fx:id="playlistSearchBar" spacing="12.0" visible="false" managed="false" alignment="CENTER_LEFT">
                <TextField fx:id="playlistSearchField" promptText="Rechercher une playlist..." styleClass="music-front-search-field" HBox.hgrow="ALWAYS" />
                <Button mnemonicParsing="false" onAction="#handleSearchPlaylist" text="Rechercher" styleClass="music-front-search-button" />
                <Button mnemonicParsing="false" onAction="#handleClearPlaylistSearch" text="Effacer" styleClass="music-front-clear-button" />
                <ComboBox fx:id="sortPlaylistComboBox" prefWidth="180.0" promptText="Trier par" styleClass="music-front-sort-combo" />
            </HBox>

            <HBox spacing="12.0" styleClass="music-front-tabs">
                <Button fx:id="musiqueSectionButton" mnemonicParsing="false" onAction="#handleShowMusiqueSection" text="Musiques" styleClass="music-front-tab-button" />
                <Button fx:id="playlistsSectionButton" mnemonicParsing="false" onAction="#handleShowPlaylistsSection" text="Playlists" styleClass="music-front-tab-button" />
            </HBox>
        </VBox>
    </top>

    <center>
        <VBox spacing="16.0" styleClass="music-front-content-container">
            <padding>
                <Insets top="30.0" right="40.0" bottom="40.0" left="40.0" />
            </padding>
            <VBox fx:id="musiqueSection" spacing="16.0" VBox.vgrow="ALWAYS">
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="music-front-scroll" VBox.vgrow="ALWAYS">
                    <VBox spacing="16.0">
                        <TilePane fx:id="musicGrid" hgap="24.0" prefColumns="3" vgap="24.0" styleClass="music-front-grid" />
                        <Label fx:id="emptyListLabel" styleClass="music-front-empty-label" text="Aucune musique disponible pour le moment." wrapText="true" visible="false" />
                    </VBox>
                </ScrollPane>
            </VBox>

            <VBox fx:id="playlistsSection" spacing="24.0" visible="false" managed="false" VBox.vgrow="ALWAYS">
                <HBox alignment="CENTER_LEFT">
                    <Label styleClass="playlist-section-title" text="Mes Playlists" />
                    <Region HBox.hgrow="ALWAYS" />
                    <Button fx:id="togglePlaylistFormButton" mnemonicParsing="false" onAction="#handleTogglePlaylistForm" styleClass="playlist-action-button" text="+ Nouvelle playlist" />
                </HBox>

                <VBox fx:id="aiPlaylistSection" spacing="12.0" styleClass="ai-playlist-card">
                    <HBox alignment="CENTER_LEFT" spacing="12.0">
                        <Label styleClass="ai-playlist-title" text="✨ Génération par IA" />
                    </HBox>
                    <Label styleClass="ai-playlist-description" text="Décrivez l'ambiance, le genre ou l'activité, et l'IA créera une playlist sur mesure pour vous." wrapText="true" />
                    <HBox spacing="12.0">
                        <TextField fx:id="aiPlaylistPromptField" promptText="Ex: Musique énergique pour l'entraînement..." styleClass="ai-playlist-prompt-field" HBox.hgrow="ALWAYS" />
                        <Button fx:id="generatePlaylistButton" mnemonicParsing="false" onAction="#handleGeneratePlaylistWithAI" styleClass="ai-playlist-generate-button" text="Générer" />
                    </HBox>
                    <Label fx:id="aiPlaylistStatusLabel" styleClass="ai-playlist-status-label" text="Prêt à générer votre playlist" wrapText="true" />
                </VBox>

                <VBox fx:id="playlistDetailSection" spacing="16.0" visible="false" managed="false" styleClass="playlist-detail-card">
                    <HBox spacing="12.0" alignment="CENTER_LEFT">
                        <VBox spacing="4.0" HBox.hgrow="ALWAYS">
                            <Label fx:id="playlistDetailTitleLabel" styleClass="playlist-detail-title" text="Aucune playlist sélectionnée" />
                            <Label fx:id="playlistDetailMetaLabel" styleClass="playlist-detail-meta" text="Cliquez sur une playlist pour voir ses musiques." wrapText="true" />
                        </VBox>
                        <Button mnemonicParsing="false" onAction="#handleEditSelectedPlaylist" styleClass="playlist-detail-edit-btn" text="Modifier" />
                        <Button mnemonicParsing="false" onAction="#handleDeleteSelectedPlaylist" styleClass="playlist-detail-delete-btn" text="Supprimer" />
                        <Button fx:id="closePlaylistDetailButton" mnemonicParsing="false" onAction="#handleClosePlaylistDetail" styleClass="playlist-detail-close-btn" text="✕" />
                    </HBox>

                    <Label fx:id="playlistSongsEmptyLabel" styleClass="playlist-detail-songs-empty" text="Aucune musique dans cette playlist." wrapText="true" />
                    <TilePane fx:id="playlistSongsBox" hgap="16.0" prefColumns="4" vgap="16.0" styleClass="music-front-grid" />
                </VBox>

                <VBox fx:id="playlistFormSection" spacing="20.0" styleClass="playlist-form-card" visible="false" managed="false">
                    <VBox spacing="6.0">
                        <Label styleClass="playlist-form-header-title" text="Créer une nouvelle playlist" />
                        <Label styleClass="playlist-form-header-subtitle" text="Personnalisez votre collection avec un nom, une description et une image." wrapText="true" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="playlist-form-label" text="Nom de la playlist" />
                        <TextField fx:id="playlistNameField" styleClass="playlist-form-input" promptText="Ex: Ma playlist d'été" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="playlist-form-label" text="Description (facultative)" />
                        <TextArea fx:id="playlistDescriptionArea" prefRowCount="3" styleClass="playlist-form-textarea" promptText="Décrivez l'ambiance ou le thème de cette playlist..." wrapText="true" />
                    </VBox>
                    <VBox spacing="8.0">
                        <Label styleClass="playlist-form-label" text="Image de couverture (facultative)" />
                        <HBox spacing="12.0">
                            <TextField fx:id="playlistImageField" editable="false" HBox.hgrow="ALWAYS" styleClass="playlist-form-input" promptText="Choisissez une image attrayante..." />
                            <Button mnemonicParsing="false" onAction="#handleChoosePlaylistImage" styleClass="playlist-form-browse-btn" text="Parcourir" />
                        </HBox>
                    </VBox>
                    <HBox alignment="CENTER_RIGHT" spacing="12.0">
                        <Button fx:id="createPlaylistButton" mnemonicParsing="false" onAction="#handleCreatePlaylist" styleClass="playlist-form-submit-btn" text="Créer la playlist" />
                    </HBox>
                </VBox>

                <Label fx:id="playlistFeedbackLabel" styleClass="playlist-feedback-label" wrapText="true" />
                <ScrollPane fitToWidth="true" hbarPolicy="NEVER" styleClass="music-front-scroll" VBox.vgrow="ALWAYS">
                    <content>
                        <TilePane fx:id="playlistGrid" hgap="24.0" prefColumns="3" vgap="24.0" styleClass="music-front-grid" />
                    </content>
                </ScrollPane>
            </VBox>
        </VBox>
    </center>
</BorderPane>
