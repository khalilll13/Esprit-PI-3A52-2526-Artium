# Copy this file to .env.local and fill in the real values before starting the project.

###> symfony/framework-bundle ###
APP_ENV=dev
APP_SECRET=change_me
APP_DEBUG=1
###< symfony/framework-bundle ###

###> doctrine/doctrine-bundle ###
DATABASE_URL="mysql://root:change_me@127.0.0.1:3306/Artium_db?serverVersion=8.0.32&charset=utf8mb4"
###< doctrine/doctrine-bundle ###

###> symfony/messenger ###
MESSENGER_TRANSPORT_DSN=doctrine://default
###< symfony/messenger ###

###> symfony/mailer ###
MAILER_DSN=smtp://user:password@smtp.gmail.com:587?encryption=tls
###< symfony/mailer ###

###> symfony/lock ###
LOCK_DSN=flock
###< symfony/lock ###

###> recaptcha ###
RECAPTCHA_SITE_KEY=change_me
RECAPTCHA_SECRET_KEY=change_me
###< recaptcha ###

###> stripe/stripe-php ###
STRIPE_SECRET_KEY=change_me
STRIPE_PUBLISHABLE_KEY=change_me
STRIPE_WEBHOOK_SECRET=change_me
###< stripe/stripe-php ###

###> meilisearch/search-bundle ###
MEILISEARCH_URL=http://127.0.0.1:7700
MEILISEARCH_API_KEY=change_me
MEILISEARCH_PREFIX=app_${APP_ENV}_
###< meilisearch/search-bundle ###

###> ai/integrations ###
GEMINI_API_KEY=change_me
COHERE_API_KEY=change_me
HUGGING_FACE_API_KEY=change_me
GENIUS_ACCESS_TOKEN=change_me
GROQ_API_KEY=change_me
GROQ_MODEL=llama-3.1-8b-instant
OLLAMA_BASE_URL=http://localhost:11434
OLLAMA_EMBED_MODEL=nomic-embed-text
OLLAMA_CHAT_MODEL=llama3.2:3b
###< ai/integrations ###

###> knplabs/knp-snappy ###
WKHTMLTOPDF_PATH=/usr/local/bin/wkhtmltopdf
###< knplabs/knp-snappy ###